+
+    /** Called by the exact busy action's error continuation, never under an outer holder monitor. */
+    void failUpgrade(Cancellable action, ItemStatus<K, V, Ctx> target,
+                     CompletableFuture<Void> slot, Throwable failure) {
+        Assertions.assertTrue(!Thread.holdsLock(this), "Failure signalling under holder monitor");
+        Objects.requireNonNull(failure);
+        var requesters = new ArrayList<CompletableFuture<Void>>();
+        var affectedTickets = new ArrayList<ItemTicket>();
+        synchronized (this) {
