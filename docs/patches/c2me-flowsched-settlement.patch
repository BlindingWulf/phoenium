+                requesters.add(this.futures[i]);
+                // Publish the terminal state before post-monitor callbacks or concurrent demand changes.
+                this.futures[i] = CompletableFuture.failedFuture(failure);
+                affectedTickets.addAll(Arrays.asList(this.tickets.getTicketsForStatusArrayCopy(target.getAllStatuses()[i])));
+            }
+        }
+        for (CompletableFuture<Void> requester : requesters) requester.completeExceptionally(failure);
+        for (ItemTicket ticket : affectedTickets) ticket.failCallback(failure);
+    }
+
