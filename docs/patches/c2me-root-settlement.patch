+"""Rebuild the patched FlowSched classes and one remapped native holder in locked C2ME."""
+import argparse
+import hashlib
+import io
+import json
+from pathlib import Path
+import subprocess
+import zipfile
+
+ROOT = Path(__file__).resolve().parent
+ORIGINAL = "B013229383F51789C57684CBCFC12981C8D791206F3B594866DFEB74AED3770B"
+CLASSES = {f"com/ishland/flowsched/scheduler/{name}.class" for name in
+           ("ItemHolder", "ItemTicket", "StatusAdvancingScheduler")}
+NATIVE_HOLDER = "com/ishland/c2me/rewrites/chunksystem/common/NewChunkHolderVanillaInterface.class"
+PATCH_VERSION = "0.4.2-alpha.0.43-phoenium-settlement2+26.2"
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest().upper()
+
+def rewrite(data, replacements, version=False):
+    result = io.BytesIO()
+    with zipfile.ZipFile(io.BytesIO(data)) as source, zipfile.ZipFile(result, "w") as target:
+        for entry in source.infolist():
+            payload = replacements.get(entry.filename, source.read(entry))
+            if version and entry.filename == "fabric.mod.json":
+                meta = json.loads(payload)
+                assert meta["version"] == "0.4.2-alpha.0.43+26.2"
+                meta["version"] = PATCH_VERSION
+                payload = json.dumps(meta, indent=2).encode() + b"\n"
+            target.writestr(entry, payload)
+    return result.getvalue()
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("original", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--rewrites", type=Path, required=True, help="Source-built remapJar for the rewrites module")
+    args = parser.parse_args()
+    original = args.original.read_bytes()
+    assert sha(original) == ORIGINAL, "Wrong locked provider"
+    assert args.original.resolve() != args.output.resolve()
+    assert not args.output.exists(), "Never overwrite an existing pinned artifact"
+    subprocess.run([str(ROOT / "FlowSched/gradlew.bat"), "-p", str(ROOT / "FlowSched"),
+                    "classes", "--rerun-tasks", "--no-daemon"], check=True, cwd=ROOT)
+    replacements = {name: (ROOT / "FlowSched/build/classes/java/main" / name).read_bytes() for name in CLASSES}
+    with zipfile.ZipFile(io.BytesIO(original)) as outer:
+        base_name, = [n for n in outer.namelist() if n.startswith("META-INF/jars/") and "base-" in n]
+        old_base = outer.read(base_name)
+        new_base = rewrite(old_base, replacements, version=True)
+        rewrites_name, = [n for n in outer.namelist() if n.startswith("META-INF/jars/") and "rewrites-chunk-system-" in n]
+        old_rewrites = outer.read(rewrites_name)
+        with zipfile.ZipFile(args.rewrites) as built:
+            native_holder = built.read(NATIVE_HOLDER)
+        new_rewrites = rewrite(old_rewrites, {NATIVE_HOLDER: native_holder}, version=True)
+        patched = rewrite(original, {base_name: new_base, rewrites_name: new_rewrites}, version=True)
+        with zipfile.ZipFile(io.BytesIO(patched)) as check:
+            assert set(check.namelist()) == set(outer.namelist())
+            changed = [n for n in outer.namelist() if check.read(n) != outer.read(n)]
+            assert set(changed) == {base_name, rewrites_name, "fabric.mod.json"}
+        with zipfile.ZipFile(io.BytesIO(old_base)) as before, zipfile.ZipFile(io.BytesIO(new_base)) as after:
+            changed_base = [n for n in before.namelist() if before.read(n) != after.read(n)]
+            assert set(changed_base) == CLASSES | {"fabric.mod.json"}
+        with zipfile.ZipFile(io.BytesIO(old_rewrites)) as before, zipfile.ZipFile(io.BytesIO(new_rewrites)) as after:
+            changed_rewrites = [n for n in before.namelist() if before.read(n) != after.read(n)]
+            assert set(changed_rewrites) == {NATIVE_HOLDER, "fabric.mod.json"}
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_bytes(patched)
+    manifest = dict(originalSha256=ORIGINAL, patchedSha256=sha(patched), size=len(patched),
+        c2meRevision=subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
+        flowSchedRevision=subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT / "FlowSched", text=True).strip(),
+        java=subprocess.run(["java", "-version"], capture_output=True, text=True).stderr,
+        changedOuterEntries=changed, changedBaseEntries=changed_base,
+        baseEntry=base_name, originalBaseSha256=sha(old_base), patchedBaseSha256=sha(new_base),
+        rewritesEntry=rewrites_name, originalRewritesSha256=sha(old_rewrites), patchedRewritesSha256=sha(new_rewrites),
+        changedRewritesEntries=changed_rewrites, nativeHolderSha256=sha(native_holder), version=PATCH_VERSION,
+        compiledClasses={n: sha(b) for n, b in replacements.items()},
+        build="python build-settlement.py ORIGINAL OUTPUT; delegates FlowSched classes --rerun-tasks --no-daemon",
+        method="Source compilation plus narrowly verified nested-archive reconstruction; all other entry payloads unchanged")
+    args.output.with_suffix(".manifest.json").write_text(json.dumps(manifest, indent=2))
+    print(json.dumps(manifest, indent=2))
+
+if __name__ == "__main__":
+    main()
