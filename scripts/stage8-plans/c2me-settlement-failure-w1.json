{
  "description": "Stage 7 exact locked C2ME provider-failure and immediate stop settlement, W1.; full selected Stage 7 co-install composition",
  "properties": {
    "level-type": "minecraft:normal"
  },
  "stopWithOutstanding": true,
  "first": [
    {
      "command": "tick freeze",
      "expect": "The game is frozen"
    },
    {
      "command": "forceload add 0 0 175 15",
      "expect": "Marked",
      "settleSeconds": 1
    },
    {
      "command": "save-all flush",
      "expect": "Saved the game"
    },
    {
      "command": "forceload remove 0 0 175 15",
      "expect": "Unmarked"
    },
    {
      "command": "save-all flush",
      "expect": "Saved the game"
    }
  ],
  "restart": [
    {
      "command": "c2meprobe arm",
      "expect": "C2ME_TEST_ARMED"
    },
    {
      "sendOnly": "forceload add 0 0 175 15"
    },
    {
      "after": "C2ME_TEST_ARMED",
      "await": "C2ME_TEST_INJECTED_FAILURE",
      "timeout": 30
    },
    {
      "after": "C2ME_TEST_INJECTED_FAILURE",
      "await": "C2ME_NATIVE_REQUESTER label=DISK",
      "timeout": 30
    }
  ],
