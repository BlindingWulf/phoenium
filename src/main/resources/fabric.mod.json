{
  "schemaVersion": 1,
  "id": "phoenium",
  "version": "${version}",
  "name": "Phoenium",
  "description": "Regionized server scheduling engine; Stage 2 serial live integration.",
  "license": "GPL-3.0-only",
  "environment": "server",
  "entrypoints": {
    "server": [
      "dev.phoenium.Phoenium"
    ]
  },
  "mixins": [
    "phoenium.mixins.json",
    "phoenium.full.mixins.json",
    "phoenium.tick.mixins.json"
  ],
  "breaks": {
    "c2me": "*",
    "c2me-rewrites-chunk-system": "*"
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-command-api-v2": "*",
    "fabric-lifecycle-events-v1": "*",
    "minecraft": "26.2",
    "java": ">=25"
  }
}
